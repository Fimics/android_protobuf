<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:paddingTop="30dp"
    android:background="@android:color/white">

    <!-- 服务器IP行 -->
    <TextView
        android:id="@+id/tv_server_ip_label"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="服务器IP:"
        android:textColor="@android:color/black"
        android:background="@android:color/holo_green_light"
        android:padding="12dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_server_ip"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:hint="例如: 10.0.2.2 (模拟器) 或 192.168.x.x"
        android:textColor="@android:color/black"
        android:background="@android:color/holo_green_light"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_server_ip_label"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 用户ID行 -->
    <TextView
        android:id="@+id/tv_user_id_label"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="用户ID:"
        android:textColor="@android:color/black"
        android:background="@android:color/holo_green_light"
        android:padding="12dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_server_ip_label"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/et_user_id"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:inputType="number"
        android:textColor="@android:color/black"
        android:background="@android:color/holo_blue_light"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/et_server_ip"
        app:layout_constraintStart_toEndOf="@id/tv_user_id_label"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- 消息内容标签 -->
    <TextView
        android:id="@+id/tv_message_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="消息内容:"
        android:textColor="@android:color/black"
        android:background="@android:color/holo_green_light"
        android:padding="12dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_user_id_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- 消息输入框 -->
    <EditText
        android:id="@+id/et_message"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:hint="输入要发送的消息..."
        android:background="@android:color/holo_orange_light"
        android:padding="12dp"
        android:gravity="top"
        android:textColor="@android:color/black"
        android:minLines="3"
        android:maxLines="4"
        app:layout_constraintTop_toBottomOf="@id/tv_message_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- 发送按钮 -->
    <Button
        android:id="@+id/btn_send"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="发送消息"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@android:color/holo_purple"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/et_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- 响应标签 -->
    <TextView
        android:id="@+id/tv_response_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="服务器响应:"
        android:textColor="@android:color/black"
        android:background="@android:color/holo_green_light"
        android:padding="12dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btn_send"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <!-- 响应显示区域 - 占据剩余所有空间 -->
    <TextView
        android:id="@+id/tv_response"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#f8f8f8"
        android:padding="16dp"
        android:text="等待响应..."
        android:textColor="#333333"
        android:textSize="14sp"
        android:gravity="top"
        android:minLines="10"
        android:scrollbars="vertical"
        android:isScrollContainer="true"
        app:layout_constraintTop_toBottomOf="@id/tv_response_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>